<%!-- About, Privacy and Projects, built from the post page's parts: masthead,
     numbered sections, margin contents and more writing --%>
<header class="masthead">
  <div class="post-meta">
    <span>Jamie Curle</span>
    <span class="reading-time">{@reading_minutes} min read</span>
  </div>
  <h1 class="page-title">{@page_title}</h1>
  <p :if={@standfirst} class="standfirst">{@standfirst}</p>
</header>

<section class="page-content">
  <aside :if={Enum.any?(@toc, &match?({2, _, _}, &1))} class="margin-nav">
    <nav aria-labelledby="contents-title">
      <h2 id="contents-title">Contents</h2>
      <ol class="numbered">
        <li :for={{2, text, anchor} <- @toc}>
          <a href={"#" <> anchor}><span>{text}</span></a>
        </li>
      </ol>
    </nav>
  </aside>

  <article>
    <div class="post-body">
      {raw(@content)}
    </div>
  </article>
</section>

<section :if={@more_posts != []} id="more-writing" class="writing-list more-writing">
  <h2>More writing</h2>
  <ol class="writing-index">
    <li :for={post <- @more_posts}>
      <a href={~p"/posts/#{post.slug}"} id={"more-post-#{post.id}"}>
        <.pretty_date date={post.published_on} />
        <span class="title"><span>{post.title}</span></span>
      </a>
    </li>
  </ol>
  <a href={~p"/posts"} class="all-writing">All writing</a>
</section>
