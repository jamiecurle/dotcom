<%!-- the masthead sits on the same cyan field as the homepage --%>
<header class="masthead">
  <%!-- only for me: a quiet way into the editor, above the title --%>
  <a
    :if={@current_scope && @current_scope.user && !@preview?}
    href={~p"/office/posts/#{@post.id}"}
    id="edit-post"
    class="edit-post"
  >
    Edit
  </a>
  <div class="post-meta">
    <.pretty_date date={@post.published_on} />
    <span class="reading-time">{@reading_minutes} min read</span>
  </div>
  <h1 class="page-title">{@post.title}</h1>
  <p :if={@post.description} class="standfirst">{@post.description}</p>
  <ul :if={@tags != []} class="post-tags" aria-label="Tags">
    <li :for={tag <- @tags}>
      <.link navigate={~p"/tags/#{tag.slug}"} id={"tag-#{tag.slug}"}>{tag.title}</.link>
    </li>
  </ul>
</header>

<section class="page-content">
  <%!-- numbered contents in the margin, numbers matching the hanging
       section numbers on each h2 in the body --%>
  <aside :if={Enum.any?(@toc, &match?({2, _, _}, &1))} class="margin-nav">
    <nav aria-labelledby="contents-title">
      <h2 id="contents-title">Contents</h2>
      <ol class="numbered">
        <li :for={{2, text, anchor} <- @toc}>
          <a href={"#" <> anchor}><span>{text}</span></a>
        </li>
      </ol>
    </nav>
  </aside>

  <article>
    <div class="post-body">
      {raw(@post.html)}
    </div>
  </article>
</section>

<%!-- the conversation lives on Bluesky; it's read back here, and replying
     happens there --%>
<section :if={@post.bluesky_uri} id="conversation" class="writing-list conversation">
  <h2>
    Replies on Bluesky<span :if={is_list(@replies) and @replies != []} class="count">{reply_count(@replies)}</span>
  </h2>

  <%= case @replies do %>
    <% :loading -> %>
      <p id="replies-loading" class="conversation-note">Fetching replies…</p>
    <% :unavailable -> %>
      <p id="replies-unavailable" class="conversation-note">
        Bluesky didn't answer just now, so the replies can't be shown.
      </p>
    <% [] -> %>
      <p id="replies-empty" class="conversation-note">No replies yet.</p>
    <% replies -> %>
      <.replies replies={replies} />
  <% end %>

  <a
    id="reply-on-bluesky"
    href={Jamie.Bluesky.web_url(@post.bluesky_uri)}
    class="all-writing"
    target="_blank"
    rel="noopener"
  >
    Reply on Bluesky
  </a>
</section>

<section :if={@more_posts != []} id="more-writing" class="writing-list more-writing">
  <h2>More writing</h2>
  <ol class="writing-index">
    <li :for={post <- @more_posts}>
      <a href={~p"/posts/#{post.slug}"} id={"more-post-#{post.id}"}>
        <.pretty_date date={post.published_on} />
        <span class="title"><span>{post.title}</span></span>
      </a>
    </li>
  </ol>
  <a href={~p"/posts"} class="all-writing">All writing</a>
</section>
